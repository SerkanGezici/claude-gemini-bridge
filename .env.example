# Gemini API key (required) — https://aistudio.google.com/apikey
# You can leave this empty: on first run in a terminal, claude-gemini will
# prompt you to paste a key, validate it, and save it automatically.
GEMINI_API_KEY=

# Model — "-latest" aliases exist only for SOME Live families (probe 2026-07-03:
# …native-audio-latest works; the 3.1-live family has none). Startup model
# discovery validates the name against models.list and fails fast if invalid.
# Recommended (quality): models/gemini-3.1-flash-live-preview (TPM=65K — tight quota)
# Alternative (large quota): models/gemini-2.5-flash-native-audio-preview-12-2025 (TPM=1M)
GEMINI_MODEL=models/gemini-3.1-flash-live-preview

# Quota (1011/TPM) fallback model — when the primary model hits its quota, the
# bridge switches to this one for the cooldown window, then switches back.
# 'none' = disable fallback.
GEMINI_FALLBACK_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
# How long to stay on the fallback model (ms) — the TPM window is ~1 min
QUOTA_COOLDOWN_MS=60000

# Plain (non-Live) model used for the synthetic web_search tool's REST grounding
# (googleSearch) sub-request. "-latest" aliases are valid here too.
# Free-tier grounding budget (measured 2026-07-06): ~20 searches/day, 5/min —
# switching REST models does NOT raise it (see PLANS/archive/SEARCH-QUOTA-PROBE-*.md).
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# SEARCH-LIVE-1: Live-grounded fallback used when the REST search quota is
# exhausted (or REST hits a transient error). Separate, effectively unlimited
# pool (measured 2026-07-07: 21 searches/day no wall, TPM-bound only) at the
# cost of +5-10s latency. 'none' disables. NOTE: the 3.1-live family does NOT
# support grounding (instant 1011) — pick a 2.5 audio model.
GEMINI_SEARCH_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025

# Bridge settings
# Set SKIP_KEY_CHECK=1 to skip the interactive startup API-key validation.
PORT=8002
HOST=127.0.0.1
DEBUG=false
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=2000
# If left empty, a random token is generated on each start
BRIDGE_TOKEN=

# ── ROUTE-1: request routing (3 lanes + learning quota registry) ──
# Measured basis: PLANS/archive/MODEL-MATRIX-PROBE-2026-07-03.md
# ROUTING=off disables all routing (single-lane legacy behavior).
ROUTING=on
# background lane: requests Claude Code itself marks as "haiku" (summaries,
# compaction) go to the 1M-TPM Live model instead of burning the 65K quota.
LANE_BACKGROUND_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
# longcontext lane: requests measured above the threshold go to a 1M-context
# REST model (real functionCall history, no flattening). Daily budget guards
# the model's RPD limit (flash-lite free tier: 500/day).
LANE_LONGCONTEXT_MODEL=gemini-3.1-flash-lite
LANE_LONGCONTEXT_ENABLED=true
LONGCONTEXT_THRESHOLD_TOKENS=50000
LONGCONTEXT_RPD_BUDGET=450
# Overflow: when the quality lane's TPM window is in debt, requests up to this
# size may spill to the background lane; heavy turns never spill.
OVERFLOW_LIGHT_MAX_TOKENS=12000
# Emergency lane (REST, default OFF): serves background requests when both Live
# lanes are cooling down. Example: gemma-4-31b-it (unlimited TPM, weak wording).
LANE_EMERGENCY_MODEL=
# Set SKIP_MODEL_CHECK=1 to skip the startup models.list validation.
# ADR-0004: document tools (office MCP: office_inspect / office_compare). Install once with
# `claude-gemini --setup-docs`; set to off to disable.
BRIDGE_OFFICE_MCP=on
